{
  "name": "color-pad",
  "version": "0.1.0",
  "description": "ClojureScript workflow using Calcit Editor",
  "main": "index.js",
  "scripts": {
    "compile": "calcit calcit.cirru js",
    "build": "yarn compile && vite build --base=${VITE_BASE_URL:-./}",
    "dev": "yarn compile && vite"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Memkits/color-pad.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@calcit/procs": "0.27.0",
    "copy-text-to-clipboard": "^3.2.2"
  },
  "packageManager": "yarn@4.18.0"
}
